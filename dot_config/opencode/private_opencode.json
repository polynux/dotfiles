{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "webfetch": "allow",
    "websearch": "allow",
    "browser_*": "allow"
  },
  "provider": {
    "openlux": {
      "name": "Openlux",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://api.openlux.ai/v1",
        "apiKey": "{env:OPENLUX_API_KEY}"
      },
      "models": {
        "gpt-5.6-sol": {
          "name": "GPT-5.6 Sol",
          "limit": { "context": 400000, "output": 128000 }
        },
        "gpt-5.6-sol-ultra": {
          "name": "GPT-5.6 Sol Ultra",
          "limit": { "context": 400000, "output": 128000 }
        },
        "gpt-5.6-terra": {
          "name": "GPT-5.6 Terra",
          "limit": { "context": 400000, "output": 128000 }
        },
        "gpt-5.6-luna": {
          "name": "GPT-5.6 Luna",
          "limit": { "context": 400000, "output": 128000 }
        },
        "gpt-5.5": {
          "name": "GPT-5.5",
          "limit": { "context": 400000, "output": 128000 }
        },
        "gpt-5.5-pro": {
          "name": "GPT-5.5 Pro",
          "limit": { "context": 400000, "output": 128000 }
        },
        "gpt-5.4": {
          "name": "GPT-5.4",
          "limit": { "context": 400000, "output": 128000 }
        },
        "gpt-5.3-codex": {
          "name": "GPT-5.3 Codex",
          "limit": { "context": 400000, "output": 128000 }
        }
      }
    },
    "ollama": {
      "models": {
        "glm-5.1:cloud": {
          "_launch": true,
          "limit": {
            "context": 202752,
            "output": 131072
          },
          "name": "glm-5.1:cloud"
        },
        "glm-5:cloud": {
          "_launch": true,
          "limit": {
            "context": 202752,
            "output": 131072
          },
          "name": "glm-5:cloud"
        }
      },
      "name": "Ollama",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1"
      }
    }
  },
  "mcp": {
    "godot": {
      "type": "local",
      "command": ["npx", "-y", "@coding-solo/godot-mcp"],
      "enabled": false,
      "environment": {
        "GODOT_PATH": "/usr/bin/godot",
        "DEBUG": "false"
      }
    },
    "browser": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest",
        "--browser=chromium",
        "--caps=pdf,vision,devtools"
      ],
      "enabled": true,
      "timeout": 120000
    },
    "browser-headless": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest",
        "--browser=chromium",
        "--caps=pdf,vision,devtools",
        "--headless"
      ],
      "enabled": false,
      "timeout": 120000
    }
  }
}
